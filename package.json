{
  "name": "aws-resilience-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test test/*.test.ts tests/aws-conformance/**/*.test.ts && npm run test:ui",
    "test:unit": "node --experimental-strip-types --test test/*.test.ts",
    "test:conformance": "node --experimental-strip-types --test tests/aws-conformance/**/*.test.ts",
    "test:ui": "node --import ./test/support/register.mjs --test test/ui/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
